<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <TransparentMaterials>
        <!--
            The materials Lumel draws with, packed into every mod built on it. The file is named for Lumel so it sits
            beside a mod's own TransparentMaterials.sbc; two mods defining the same Lumel material define it identically.
        -->

        <!-- Flat white, tinted to whatever color is asked for: a color multiply lands on exactly the tone requested. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Lumel_Fill</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\GUI\Blank.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- A soft shade fading out from a solid middle, laid as nine slices under a window: the shadow it casts. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Lumel_Shadow</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Lumel_Shadow.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- A white disc with a smooth edge, tinted to whatever color is asked for: the dot of a radio button. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Lumel_Disc</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Lumel_Disc.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- A white ring an eighth of its width thick, tinted to whatever color is asked for: the edge of a radio button. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Lumel_Ring</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Lumel_Ring.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- Every hue from red at the top round to red at the bottom: a hue strip. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Lumel_Hues</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Lumel_Hues.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- White fading from the left edge to nothing at the right: the saturation of a color spectrum. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Lumel_Pale</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Lumel_Pale.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>

        <!-- Black rising from nothing at the top to solid at the bottom: the value of a color spectrum. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Lumel_Dark</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Lumel_Dark.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>
        <!-- A row of white dots a dot apart: a slice of it, as long as the line, is a dotted line. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>Lumel_Dots</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <AlphaSaturation>1</AlphaSaturation>
            <Emissivity>0</Emissivity>
            <IgnoreDepth>false</IgnoreDepth>
            <NeedSort>false</NeedSort>
            <SoftParticleDistanceScale>0</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\Lumel_Dots.dds</Texture>
            <Reflectivity>0</Reflectivity>
            <UseAtlas>false</UseAtlas>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
        </TransparentMaterial>
    </TransparentMaterials>
</Definitions>
