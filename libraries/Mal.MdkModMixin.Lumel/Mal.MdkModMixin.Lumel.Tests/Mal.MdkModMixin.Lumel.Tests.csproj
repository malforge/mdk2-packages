<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\build\Lumel.GameReferences.props" />

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <Nullable>annotations</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- xunit v3 test projects are executables. -->
        <OutputType>Exe</OutputType>
        <RootNamespace>Lumel.Tests</RootNamespace>

        <!-- Lumel.Sim's needs: the game's 64-bit assemblies, DirectXTexNet's native half, and its glyph page copies. -->
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>

        <!-- The game's assemblies were built against older System.Memory and its kin than the tests carry. -->
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
        <PackageReference Include="DirectXTexNet" Version="1.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mal.MdkModMixin.Lumel.Demo\Mal.MdkModMixin.Lumel.Demo.csproj" />
        <ProjectReference Include="..\..\Mal.MdkModMixin.Lumel.Sim\Mal.MdkModMixin.Lumel.Sim.Demo\Mal.MdkModMixin.Lumel.Sim.Demo.csproj" />
    </ItemGroup>

    <!-- Lumel's own content, read by the tests as a mod's is. -->
    <ItemGroup>
        <None Include="..\Mal.MdkModMixin.Lumel\Content\**\*">
            <Link>Content\Mods\Lumel\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
