<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lumel as the MDK2 mod template builds a mod, so the game's rules for mods hold here as in every mod built on it. -->
  <PropertyGroup>
    <TargetFramework>netframework48</TargetFramework>
    <RootNamespace>Lumel</RootNamespace>
    <LangVersion>6</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Release;Debug</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <!-- A Release build also packs each shared project imported below as a source package, into packages/ beside the solution. -->
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.SharedNugetBuilder" Version="1.0.13">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="thumb.png" Condition="Exists('thumb.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <None Remove="thumb.png" />
  </ItemGroup>
  <Import Project="..\Mal.MdkModMixin.Lumel\Mal.MdkModMixin.Lumel.projitems" Label="Shared" />
</Project>
